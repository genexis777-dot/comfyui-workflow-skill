    "sd15-inpaint": {
      "file": "templates/6gb/sd15-inpaint.json",
      "tier": 2,
      "task": "inpaint",
      "notes": "512 input + mask. Use inpainting checkpoint."
    },
    "sd15-controlnet": {
      "file": "templates/6gb/sd15-controlnet.json",
      "tier": 2,
      "task": "controlnet",
      "notes": "One ControlNet. Try after txt2img. Use --lowvram if tight."
    },
    "upscale-model": {
      "file": "templates/6gb/upscale-model.json",
      "tier": 2,
