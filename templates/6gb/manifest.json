{
  "profile": "gtx-1660-ti-6gb",
  "templates": {
    "sd15-txt2img": {
      "file": "templates/6gb/sd15-txt2img.json",
      "tier": 1,
      "task": "txt2img",
      "notes": "Start here. 512x512 SD 1.5. Lightest graph."
    },
    "sd15-lora": {
      "file": "templates/6gb/sd15-lora.json",
      "tier": 1,
